FROM registry.fedoraproject.org/fedora-toolbox:42

LABEL com.github.containers.toolbox="true" \
      usage="This image is meant to be used with the toolbox or distrobox command" \
      summary="Flatpak Builder image for Atelier Damillora" \
      maintainer="developer@damillora.com"


# Copy the setup scripts and package list
COPY ../scripts/distrobox-shims.sh /

ENV FLATPAK_GL_DRIVERS=dummy
RUN dnf -y update && dnf install -y flatpak-builder ostree fuse elfutils dconf git bzr
RUN flatpak remote-add flathub https://dl.flathub.org/repo/flathub.flatpakrepo
